# Copy to .env.local (gitignored) and fill in.
REGION=us-east-1
STACK=agentcore-inference
CFN_BUCKET=cf-templates-xxxxxxxx-us-east-1
DOMAIN_PREFIX=agentcore-gateway-<globally-unique>
DAILY_BUDGET_USD=2
MONTHLY_BUDGET_USD=10

# End users: <cognito user>:<cognito group>:<email>:<daily cap USD>:<monthly cap USD>
# One entry per user; Cognito emails each one a temporary password.
GATEWAY_USERS='finanzas-user:finanzas-builders:you+finanzas@example.com:1:10 platform-user:platform-engineers:you+platform@example.com:2:20'

# Group -> allowed model IDs, one per seat like a licence tier (must be in config/price-table.json).
# Models on the bedrock-runtime target use inference profile IDs; Mantle models (Sonnet 5, Opus 5.5) stay pending quotas.
MODEL_ALLOWLIST_JSON='{"finanzas-builders":["us.anthropic.claude-haiku-4-5-20251001-v1:0"],"platform-engineers":["us.anthropic.claude-sonnet-4-6"]}'
