{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyDirectBedrockInferenceExceptGateway",
      "Effect": "Deny",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream",
        "bedrock:Converse",
        "bedrock:ConverseStream",
        "bedrock-mantle:CallWithBearerToken",
        "bedrock-mantle:CreateInference",
        "bedrock-mantle:GetInference"
      ],
      "Resource": "*",
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::*:role/<GATEWAY_ROLE_NAME>",
            "arn:aws:iam::*:role/<BREAK_GLASS_ROLE_NAME>"
          ]
        }
      }
    }
  ]
}
